rules_version = '2';

// Grove — Firestore security rules
//
// Layout (must match src/lib/sync/firestoreSync.ts):
//   /users/{uid}                      -> { settings, world }
//   /users/{uid}/subjects/{id}        -> Subject
//   /users/{uid}/topics/{id}          -> Topic
//   /users/{uid}/tasks/{id}           -> Task
//   /users/{uid}/sessions/{id}        -> StudySession
//   /users/{uid}/wellness/{id}        -> WellnessEntry
//   /users/{uid}/routine/{id}         -> RoutineBlock
//   /users/{uid}/achievements/{id}    -> UnlockedAchievement
//
// Every document under /users/{uid} may only be read or written by the
// signed-in user with that uid — no one else can read or write another
// user's grove, and unauthenticated requests are always denied.

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      match /{subcollection}/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Community Features
    match /usernames/{username} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    match /profiles/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    match /friendRequests/{requestId} {
      // Both sender and receiver can read
      allow read: if request.auth != null && (request.auth.uid == resource.data.senderUid || request.auth.uid == resource.data.receiverUid);
      // Sender creates the request
      allow create: if request.auth != null && request.auth.uid == request.resource.data.senderUid;
      // Receiver can update (accept) or delete (reject/cancel)
      allow update, delete: if request.auth != null && (request.auth.uid == resource.data.senderUid || request.auth.uid == resource.data.receiverUid);
    }

    match /friendships/{friendshipId} {
      // Must be a member to read or write
      allow read: if request.auth != null && request.auth.uid in resource.data.users;
      allow write: if request.auth != null && request.auth.uid in request.resource.data.users;
      allow delete: if request.auth != null && request.auth.uid in resource.data.users;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
